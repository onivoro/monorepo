{
  "name": "@onivoro/server-aws-cognito",
  "version": "25.3.1",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./*.js": "./*.js",
    "./*": "./*.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onivoro/monorepo.git"
  },
  "dependencies": {
    "@onivoro/server-aws-credential-providers": "25.3.1",
    "@onivoro/server-common": "25.3.1",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "*",
    "@nestjs/common": "*",
    "@nestjs/swagger": "*",
    "express": "*",
    "jsonwebtoken": "*",
    "jwk-to-pem": "*",
    "jwks-rsa": "*"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.js.map",
    "README.md"
  ],
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
