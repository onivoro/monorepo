{
  "name": "@onivoro/server-pg-notify",
  "version": "25.4.0",
  "description": "Postgres LISTEN/NOTIFY for NestJS: a subscription that survives losing its connection, a publisher that respects the payload limit, and trigger migration helpers",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./listener": {
      "types": "./src/listener.d.ts",
      "default": "./src/listener.js"
    },
    "./package.json": "./package.json",
    "./*.js": "./*.js",
    "./*": "./*.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "homepage": "https://github.com/onivoro/monorepo/blob/main/libs/server/pg-notify/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/onivoro/monorepo.git"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "listen",
    "notify",
    "pg-listen",
    "pubsub",
    "nestjs",
    "typeorm"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "pg": "7.x || 8.x",
    "pg-listen": "~1.7.0",
    "typeorm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.js.map",
    "README.md"
  ]
}
