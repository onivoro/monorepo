# JWT Auth Configuration
JWKS_URI=https://your-auth-provider/.well-known/jwks.json
JWT_ISSUER=https://your-auth-provider/
# The `aud` your authorization server puts in tokens issued for this server.
# Tokens for any other audience are rejected.
JWT_AUDIENCE=http://localhost:3000/mcp
# The public URL of the MCP endpoint (HTTP transport only), advertised in
# /.well-known/oauth-protected-resource.
MCP_RESOURCE_URL=http://localhost:3000/mcp

# Server
PORT=3000
