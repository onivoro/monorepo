{
  "name": "onivoro",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "random": "echo 'pass a numeric arg to change the default length of 16' & bun tools/scripts/rando.ts",
    "db:up:local": "cd docker/dev && docker compose up -d --remove-orphans",
    "db:down:local": "cd docker/dev && docker compose down",
    "fmt": "nx format --fix",
    "setup:mcp": "node scripts/setup-mcp-config.js",
    "setup:mcp:dry-run": "node scripts/setup-mcp-config.js --dry-run",
    "test": "npm run test:unit",
    "test:unit": "nx run-many -t test --passWithNoTests",
    "_release_comment": "1) release:patch/minor/major versions, commits, tags and builds  2) release:publish -- --otp=<code>  3) release:push",
    "release:patch": "npm run release:preflight && nx release version patch && npm run release:build",
    "release:minor": "npm run release:preflight && nx release version minor && npm run release:build",
    "release:major": "npm run release:preflight && nx release version major && npm run release:build",
    "release:preflight": "test \"$(git branch --show-current)\" = main || { echo 'ERROR: release from main'; exit 1; }; git diff --quiet HEAD || { echo 'ERROR: commit or stash your changes first'; exit 1; }; npm whoami > /dev/null || { echo 'ERROR: not logged in to npm. Run npm login, and check that no repo .npmrc overrides it'; exit 1; }",
    "release:build": "nx run-many -t build --projects='lib-server-*,lib-isomorphic-*,lib-browser-*' --skip-nx-cache",
    "release:publish": "nx release publish",
    "release:push": "git push origin main \"v$(node -p \"require('./libs/server/common/package.json').version\")\"",
    "release:dry-run": "nx release version --dry-run",
    "release:publish:dry-run": "nx release publish --dry-run"
  },
  "private": true,
